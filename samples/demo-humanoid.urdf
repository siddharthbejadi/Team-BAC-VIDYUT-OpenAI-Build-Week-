<?xml version="1.0"?>
<robot name="demo_humanoid">
  <link name="torso">
    <inertial><origin xyz="0 0 0.55"/><mass value="7.2"/><inertia ixx="1.2" iyy="1.0" izz="0.5"/></inertial>
    <collision><geometry><box size="0.35 0.2 0.55"/></geometry></collision>
  </link>
  <link name="left_leg">
    <inertial><origin xyz="0 0 -0.3"/><mass value="1.2"/><inertia ixx="0.12" iyy="0.1" izz="0.04"/></inertial>
    <collision><geometry><cylinder radius="0.06" length="0.6"/></geometry></collision>
  </link>
  <joint name="left_hip_pitch" type="revolute">
    <parent link="torso"/><child link="left_leg"/><limit lower="-1.2" upper="1.2" effort="32" velocity="4"/>
  </joint>
</robot>
